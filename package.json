{
  "name": "granola-to-minutes",
  "version": "0.4.1",
  "description": "CLI migration tool that exports Granola meeting data — AI summaries, transcripts, and human notes — to Minutes-native markdown with YAML frontmatter",
  "type": "module",
  "bin": {
    "granola-to-minutes": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "check": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "granola",
    "minutes",
    "meeting-notes",
    "migration",
    "cli",
    "typescript",
    "export",
    "markdown",
    "transcript",
    "ai-summary",
    "frontmatter"
  ],
  "author": {
    "name": "Calvin",
    "url": "https://github.com/calvindotsg"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calvindotsg/granola-to-minutes.git"
  },
  "homepage": "https://github.com/calvindotsg/granola-to-minutes#readme",
  "bugs": {
    "url": "https://github.com/calvindotsg/granola-to-minutes/issues"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
