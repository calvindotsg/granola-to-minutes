{
  "name": "granola-to-minutes",
  "version": "0.1.0",
  "description": "One-time CLI migration tool: export Granola meetings to Minutes-native markdown",
  "type": "module",
  "bin": {
    "granola-to-minutes": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "granola",
    "minutes",
    "meeting-notes",
    "migration"
  ],
  "author": "John Smith",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
