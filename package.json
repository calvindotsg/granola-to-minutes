{
  "name": "granola-to-minutes",
  "version": "0.2.0",
  "description": "One-time CLI migration tool: export Granola meetings to Minutes-native markdown",
  "type": "module",
  "bin": {
    "granola-to-minutes": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "check": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "granola",
    "minutes",
    "meeting-notes",
    "migration"
  ],
  "author": "John Smith",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
